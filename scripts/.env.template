# URL Shortener - Environment Configuration Template
# Copy this file to .env and fill in your values
# cp scripts/.env.template scripts/.env

# AWS Configuration
AWS_REGION=eu-west-1

# Project Configuration
# The project name used in your DynamoDB table names
# Example: if your table is "url-shortener-myproject-auth-users-prod"
# then PROJECT_NAME=myproject
PROJECT_NAME=myproject

# Product and Environment (usually these stay the same)
PRODUCT_NAME=url-shortener
ENVIRONMENT=prod

# Optional: Default creator for API keys (if not specified)
DEFAULT_CREATOR=system
