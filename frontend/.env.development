# Development environment variables
# Ces variables sont utilisées uniquement en développement local (npm run dev)

# L'API endpoint est vide en dev car on utilise le proxy Vite
VITE_API_ENDPOINT=

# Pour des tests rapides, vous pouvez réduire les timeouts
# VITE_TOKEN_EXPIRY_HOURS=0.1
# VITE_INACTIVITY_TIMEOUT_MINUTES=2
